{
    "name": "RadioMapSteerWOcarsDPM-SLF-DM",
    "phase": "train", // train or val
    "gpu_ids": [
        1
    ],
    "path": { //set the path
            "exp": "modelsss/trainedSLF",
            "log": "logs",
            "tb_logger": "tb_logger",
            "results": "results",
            "mat_results": "mat_results",
            "checkpoint": "checkpoint",
            "dataprocessor": "dataprocessor",
            "resume_state": null
    },
    "datasets": {
        "name": "RadioMapSteerWOcarsDPM-625Buildings",
        "type": "SLF",
        // "data_root_dir": "/scratch/shared-data/SC/Data_51",
        "data_root_dir": "/nfs/stak/users/xul2/hpc-share/datasets/SC/RadioMapSeer",
        "gain_folder": "DPM",
        "building_mask_folder": "buildings_complete",
        "car_mask_folder": null,
        "road_mask_folder": null,
        "train": {
            "data_frac": 0.8916
        }
    },
    "model": {
        "which_model_G": "ddpm",
        "finetune_norm": false,
        "unet": {
            "in_channel": 2,
            "out_channel": 1,
            "inner_channel": 64,
            "channel_multiplier": [
                1,
                2,
                4,
                8,
                8
            ],
            "attn_res": [
                16
            ],
            "res_blocks": 2,
            "dropout": 0.2
        },
        "beta_schedule": { // use munual beta_schedule for acceleration
            "train": {
                "schedule": "linear",
                "n_timestep": 2000,
                "linear_start": 1e-6,
                "linear_end": 1e-2
            },
            "val": {
                "schedule": "linear",
                "n_timestep": 2000,
                "linear_start": 1e-6,
                "linear_end": 1e-2
            }
        },
        "diffusion": {
            "image_size": 256,
            "channels": 1, //sample channel
            "conditional": true, // unconditional generation
            "loss_type": "l1"
        }
    },
    "train": {
        "n_iter": 30000000,
        "val_freq": 1e4,
        "save_checkpoint_freq": 1e4,
        "print_freq": 20,
        "optimizer": {
            "type": "adam",
            "lr": 1e-5
        },
        "ema_scheduler": { // not used now
            "step_start_ema": 5000,
            "update_ema_every": 1,
            "ema_decay": 0.9999
        }
    },
    "wandb": {
        "project": "SC-Diffuse-SLF-DM"
    }
}
